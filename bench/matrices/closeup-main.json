{
  "reps": 1,
  "workspaces": [
    "baseline",
    "atomized",
    "sharded"
  ],
  "scenarios": [
    "full"
  ],
  "runners": [
    "ct",
    "e2e",
    "unit",
    "all"
  ],
  "parallel": [
    8
  ],
  "rotate": true,
  "env": {
    "SHARD_TARGET_SECONDS": "15"
  },
  "cooldownSec": 20,
  "minMemAvailableGb": 16,
  "memWaitTimeoutMin": 30,
  "out": "results/closeup/raw",
  "runArgs": {
    "interval": 250,
    "timeout-min": 60
  }
}

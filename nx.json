{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "neverConnectToCloud": true,
  "analytics": false,
  "defaultBase": "main",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/*.cy.tsx",
      "!{projectRoot}/**/*.spec.ts",
      "!{projectRoot}/**/*.spec.tsx",
      "!{projectRoot}/cypress/**/*",
      "!{projectRoot}/cypress.config.ts",
      "!{projectRoot}/vitest.config.ts",
      "!{projectRoot}/playwright.config.ts",
      "!{projectRoot}/src/test-setup.ts",
      "!{projectRoot}/tsconfig.json"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/tsconfig.base.json"
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": [
        "^build"
      ]
    },
    "component-test-ci--*/**": {
      "parallelism": true
    }
  },
  "plugins": [
    {
      "plugin": "@nx/cypress/plugin",
      "options": {
        "componentTestingTargetName": "component-test",
        "openTargetName": "open-cypress"
      }
    },
    {
      "plugin": "@nx/playwright/plugin",
      "options": {
        "targetName": "e2e",
        "ciTargetName": ""
      }
    },
    {
      "plugin": "@nx/vitest",
      "options": {
        "testTargetName": "test",
        "testMode": "run"
      }
    },
    {
      "plugin": "./tools/shard-plugin/src/cypress-ct.ts",
      "options": {
        "ciTargetName": "component-test-ci",
        "delegateTarget": "component-test"
      }
    },
    {
      "plugin": "./tools/shard-plugin/src/playwright.ts",
      "options": {
        "ciTargetName": "e2e-ci",
        "delegateTarget": "e2e",
        "dependsOn": [
          {
            "target": "serve-static",
            "dependencies": true
          },
          {
            "target": "e2e--wait-for-webserver"
          }
        ]
      }
    },
    {
      "plugin": "./tools/shard-plugin/src/vitest.ts",
      "options": {
        "ciTargetName": "test-ci",
        "delegateTarget": "test"
      }
    }
  ]
}
